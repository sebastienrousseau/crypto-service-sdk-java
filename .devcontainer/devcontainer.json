//
// Java 21 (the build targets 17), Node 24 and pnpm for the crypto-server
// the conformance kit runs against, Python 3.12 for the manual, and the
// docs-lint tools. On creation it runs `make check`; `make regression`
// then runs everything CI runs.
{
  "name": "crypto-service-sdk-java",
  "image": "mcr.microsoft.com/devcontainers/java:1-21-bookworm@sha256:0af991049cded4b8d5a90d2614289ceec390779ad6a3e4b70957e2b4f3bb1230",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/node:1": { "version": "24" }
  },
  "postCreateCommand": "pip install --user reuse==6.2.0 codespell==2.4.3 && corepack enable && make check",
  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack", "EditorConfig.EditorConfig"]
    }
  }
}
